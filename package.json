{
  "name": "aztec-staking-payout",
  "version": "0.1.0",
  "description": "Weekly settlement tool for Aztec sequencer operators — computes each delegator's share of the period's rewards at an operator-chosen commission rate, and emits a Multicall3 batch of ERC20 transfers ready to sign through whatever wallet the operator uses.",
  "private": true,
  "type": "module",
  "bin": {
    "aztec-staking-payout": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "settle": "tsx src/cli.ts settle",
    "settle:dry-run": "tsx src/cli.ts settle --dry-run",
    "settle:emit-calldata": "tsx src/cli.ts settle --emit-calldata",
    "status": "tsx src/cli.ts status",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
